{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IncidentsAndReadingsTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:GetItem",
        "dynamodb:UpdateItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/nigrani-incidents",
        "arn:aws:dynamodb:*:*:table/saferecess-readings"
      ]
    },
    {
      "Sid": "PhotoBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::nigrani-photos-prod/*"
    },
    {
      "Sid": "BedrockVision",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": "*"
    }
  ]
}
