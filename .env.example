# Copy this file to .env and fill in whatever you have.
# SafeRecess runs fully end-to-end with ZERO keys set — every value below is optional.

# --- Live AQI data (optional) ---
# Get a free token in under a minute: https://aqicn.org/data-platform/token/
# Without this, SafeRecess uses the bundled real Delhi-NCR AQI snapshot
# (captured 2026-10-10 from CPCB/DPCC data via aqicn.org) instead of live data.
# Note: the special token "demo" does NOT work for this — it always returns a
# fixed Shanghai sample. You need your own free token for real Delhi data.
WAQI_API_TOKEN=

# --- LLM-backed advisory agent (optional) ---
# Without this, SafeRecess uses a deterministic rule-based advisory generator
# (same risk engine, no LLM) — the app still fully works, just without the
# natural-language agent reasoning.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-haiku-4-5-20251001

# --- AWS DynamoDB history logging (optional) ---
# Run `docker compose up -d` then `python scripts/setup_dynamodb.py` to stand
# up a local DynamoDB table via LocalStack, then uncomment these lines.
# Point AWS_ENDPOINT_URL at real AWS instead of LocalStack and the exact same
# code writes to a real DynamoDB table.
# Without this, history is appended to a local JSON file instead.
# AWS_ENDPOINT_URL=http://localhost:4566
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# DYNAMODB_TABLE=saferecess-readings
